{
  "name": "penai",
  "version": "1.20.7",
  "description": "PenAI — nền tảng AI Agent cho doanh nghiệp (chat đa kênh, kho tri thức, skill, MCP) chạy trên VPS riêng",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "tsx packages/db/src/cli-migrate.ts",
    "db:seed": "tsx packages/db/src/cli-seed.ts",
    "setup:admin": "tsx packages/db/src/cli-setup.ts",
    "user:create": "tsx packages/db/src/cli-user.ts",
    "dev": "tsx watch apps/server/src/index.ts",
    "start": "tsx apps/server/src/index.ts",
    "mock-llm": "tsx apps/server/src/mock-llm-server.ts",
    "codex:login": "tsx packages/providers/src/codex/cli-login.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:editor": "node scripts/build-editor-vendor.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/node": "^24.0.0",
    "esbuild": "~0.25.12",
    "markdown-it": "14.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
