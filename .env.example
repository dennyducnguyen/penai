# Mẫu biến môi trường cho CHẠY THỬ TRÊN MÁY (pnpm dev). Bản cài trên VPS không
# dùng file này: script deploy/install.sh tự sinh /etc/penai/penai.env.

# Kết nối PostgreSQL (cần extension pgvector)
DATABASE_URL=postgres://penai_app:penai_app@127.0.0.1:5432/penai
DATABASE_URL_ADMIN=postgres://postgres@127.0.0.1:5432/penai

# Khóa chủ mã hóa AES-256-GCM (base64 của 32 byte ngẫu nhiên). MẤT KHÓA NÀY =
# mất mọi token/API key đã lưu. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PENAI_MASTER_KEY=

# Địa chỉ công khai của hệ thống (link file, OAuth MCP, webhook)
PENAI_PUBLIC_URL=http://127.0.0.1:18800

# Đường dẫn file cấu hình (mặc định penai.config.json5 ở thư mục đang chạy)
# PENAI_CONFIG=./penai.config.json5
